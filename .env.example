# HTTP
PORT=8080
PUBLIC_BASE_URL=https://untappd-mcp.example.com
MCP_ALLOWED_ORIGINS=https://claude.ai

# Public Firebase Web config used only by the OAuth browser sign-in page.
FIREBASE_PROJECT_ID=beer-degustation
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=beer-degustation.firebaseapp.com
FIREBASE_WEB_APP_ID=

# OAuth 2.1 token lifetimes. The defaults are suitable for production.
MCP_ACCESS_TOKEN_TTL_SECONDS=900
MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_SESSION_TTL_SECONDS=604800

# Untappd application credentials. Keep these in Secret Manager in production.
UNTAPPD_CLIENT_ID=
UNTAPPD_CLIENT_SECRET=
UNTAPPD_REDIRECT_URI=https://untappd-mcp.example.com/connect/untappd/callback
UNTAPPD_USER_AGENT=Untappd MCP (replace-with-client-id)

# 32-byte base64 key, for example: openssl rand -base64 32
UNTAPPD_TOKEN_ENCRYPTION_KEY=
# Random HMAC secret used to sign short-lived OAuth state values.
CONNECT_STATE_SECRET=

# Firebase Admin uses Application Default Credentials on Cloud Run.
